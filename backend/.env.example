# Start with MOCK_MODE=true. Change to false after hardware pairing.
MOCK_MODE=true
APP_TOKEN=change-me-to-a-long-random-string

# Philips Hue Bridge local API
HUE_BRIDGE_IP=
HUE_USERNAME=

# Govee OpenAPI (used for discovery/control in V1)
GOVEE_API_KEY=
GOVEE_DEVICE_ID=
GOVEE_SKU=H6860

# Optional light ID mappings returned by Hue /api/<username>/lights
# Comma separated Hue numeric IDs. Keep bulb and Lily groups separate.
HUE_A19_IDS=
HUE_LILY_IDS=
