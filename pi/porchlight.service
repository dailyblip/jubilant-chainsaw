[Unit]
Description=PorchLight Hue + Govee Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/porchlight/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/porchlight/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8787
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
